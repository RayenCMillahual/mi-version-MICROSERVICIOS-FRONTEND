# .env CORREGIDO

# Database passwords
POSTGRES_PASSWORD=postgres_secure_password_2024
MYSQL_ROOT_PASSWORD=mysql_secure_password_2024
MONGO_ROOT_PASSWORD=mongo_secure_password_2024

# JWT (MISMO PARA GATEWAY Y USERS)
